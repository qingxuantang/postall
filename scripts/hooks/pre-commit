#!/usr/bin/env bash
# OSS secret / structural guard — makes gate 3 (脱敏) a hard door.
# Scans STAGED added lines only. Any hit blocks the commit (exit 1).
# Wire it once with:   git config core.hooksPath scripts/hooks
# Emergency bypass (use sparingly, on purpose): git commit --no-verify
set -euo pipefail

fail=0
note() { echo "  ✗ $1"; fail=1; }

# Added lines in the staged diff (strip the leading '+', skip file headers).
added="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+' | sed 's/^+//' || true)"
# Staged file paths.
files="$(git diff --cached --name-only --diff-filter=ACM || true)"

echo "[oss-guard] scanning staged changes…"

# ── 1. Secret VALUE shapes (target hardcoded values, not env-var names) ──
declare -A patterns=(
  ["GitHub token"]='gh[pousr]_[A-Za-z0-9]{36}'
  ["GitHub PAT"]='github_pat_[A-Za-z0-9_]{50,}'
  ["Anthropic key"]='sk-ant-[A-Za-z0-9_-]{20,}'
  ["OpenAI-style key"]='sk-[A-Za-z0-9]{32,}'
  ["Google API key"]='AIza[0-9A-Za-z_-]{35}'
  ["Telegram bot token"]='[0-9]{8,10}:[A-Za-z0-9_-]{35}'
  ["private deploy path"]='/opt/(postall|michelin)|/root/[A-Za-z._-]'
  ["owner email"]='xiucatwithmark@gmail\.com'
)
for name in "${!patterns[@]}"; do
  hit="$(printf '%s\n' "$added" | grep -nE "${patterns[$name]}" || true)"
  [ -n "$hit" ] && note "$name detected in added lines:" && printf '%s\n' "$hit" | sed 's/^/      /'
done

# ── 2. Generic hardcoded-secret assignment (skip *.example / README) ──
scan_generic="$(git diff --cached -U0 --no-color \
  --   ':(exclude)*.example' ':(exclude)*.md' ':(exclude)*.example.*' 2>/dev/null \
  | grep -E '^\+' | grep -Ev '^\+\+\+' | sed 's/^+//' || true)"
gen="$(printf '%s\n' "$scan_generic" \
  | grep -inE '(api[_-]?key|secret|token|passwd|password)\s*[:=]\s*["'"'"'][^"'"'"']{16,}' || true)"
[ -n "$gen" ] && note "hardcoded secret-looking assignment:" && printf '%s\n' "$gen" | sed 's/^/      /'

# ── 3. Structural: files that must never be committed ──
banned='(^|/)\.env$|\.tokens\.json$|(^|/)account\.json$|cookies.*\.json$|\.pem$|\.key$'
badf="$(printf '%s\n' "$files" | grep -E "$banned" || true)"
[ -n "$badf" ] && note "banned file staged (secrets/state must stay private):" && printf '%s\n' "$badf" | sed 's/^/      /'

if [ "$fail" -ne 0 ]; then
  echo "[oss-guard] BLOCKED — remove the above before committing (or --no-verify if truly intended)."
  exit 1
fi
echo "[oss-guard] clean ✓"
exit 0
